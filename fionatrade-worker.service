[Unit]
Description=FionaTrade Worker Supervisor
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=fiona
Group=fiona
WorkingDirectory=/opt/fionatrade
Environment="PATH=/opt/fionatrade/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
EnvironmentFile=/opt/fionatrade/.env

ExecStart=/opt/fionatrade/.venv/bin/python -m app.worker.supervisor

Restart=always
RestartSec=5
StartLimitInterval=120
StartLimitBurst=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fionatrade-worker

LimitNOFILE=65536
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
