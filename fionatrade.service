[Unit]
Description=FionaTrade - Autonomous Trading System
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=fiona
Group=fiona
WorkingDirectory=/opt/fionatrade
Environment="PATH=/opt/fionatrade/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
EnvironmentFile=/opt/fionatrade/.env

# Main process
ExecStart=/opt/fionatrade/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 6888 \
    --workers 1 \
    --log-level info \
    --no-access-log

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=120
StartLimitBurst=5

# Logging — journalctl -u fionatrade -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fionatrade

# Resource limits
LimitNOFILE=65536
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
