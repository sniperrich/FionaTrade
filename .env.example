APP_NAME=FionaTrade
ENV=dev
DATABASE_URL=sqlite:///./fionatrade.db
SQLITE_BUSY_TIMEOUT_SECONDS=30
POLL_INTERVAL_SECONDS=60
ENABLE_SCHEDULER=true
ENABLE_HEALTH_AUDIT=true
HEALTH_CHECK_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
LOG_DIR=logs
MARKET_BACKFILL_ALLOW_STOOQ_FALLBACK=true

# Data sources
ENABLE_SEC=true
ENABLE_RSS=true
ENABLE_FINNHUB=true
ENABLE_EARNINGS_RELEASE_SOURCE=true
SEC_USER_AGENT=FionaTrade/0.1 (your-email@example.com)
FINNHUB_API_KEY=

# LLM
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.duojie.games
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.5
LLM_RETRY_BACKOFF_MULTIPLIER=1.8
LLM_RETRY_MAX_DELAY_SECONDS=12
SEC_SUMMARY_MODEL=gemini-3-flash
SEC_SUMMARY_MAX_CHARS=1000
EVENT_TRADEABILITY_FILTER_ENABLED=true
EVENT_TRADEABILITY_MIN_SCORE=55
ENABLE_TERM_MANAGEMENT=true
TERM_SHORT_HORIZON_MIN=60
TERM_MID_HORIZON_MIN=240
TERM_LONG_HORIZON_MIN=1440

# Trading
INITIAL_NAV=100000.0
MAX_POSITION_PCT=0.15
MAX_GROSS_EXPOSURE_PCT=1.00
DAILY_LOSS_LIMIT_PCT=-0.03
DEFAULT_SLIPPAGE_BPS=4.0
SHORT_BORROW_APR=0.03
DEFAULT_HORIZON_MIN=120
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
BACKTEST_HARD_STOPS=true
BACKTEST_RISK_SIZING=true
BACKTEST_RISK_PER_TRADE_PCT=0.002
BACKTEST_DAILY_CIRCUIT_BREAKER=true
BACKTEST_ENABLE_TERM_HORIZON=false
BACKTEST_ENTRY_WINDOW_MIN=120
BACKTEST_REGIME_RISK_ADJUST=true
BACKTEST_REGIME_BULL_RISK_MULTIPLIER=1.20
BACKTEST_REGIME_BEAR_RISK_MULTIPLIER=0.80
BACKTEST_DEDUP_SAME_DAY_EVENT=true
BACKTEST_ALLOW_UNKNOWN_WITH_LLM=true
BACKTEST_ALLOW_NEXT_SESSION_ENTRY=true
BACKTEST_REGULAR_SESSION_ONLY=true
BACKTEST_MAX_NEXT_SESSION_DELAY_MIN=1080
BACKTEST_CONVICTION_POSITION_SIZING=true
BACKTEST_CONVICTION_MIN_RISK_MULTIPLIER=1.0
BACKTEST_CONVICTION_MAX_RISK_MULTIPLIER=2.5
BACKTEST_CONVICTION_POSITION_FLOOR=0.60
MIN_TRADE_CONFIDENCE=70

# Signal Validation Layer
VALIDATION_ENABLED=true
VALIDATION_MIN_REVIEW_SCORE=40
VALIDATION_REJECT_ON_STALE=true
VALIDATION_REJECT_ON_DUPLICATE=true
VALIDATION_PRICE_MOVE_THRESHOLD_PCT=3.0
VALIDATION_ALLOW_DOWNWEIGHT_EXECUTION=true
VALIDATION_STALE_MINUTES=120

# Earnings
EARNINGS_CALENDAR_AUTO_REFRESH=true
EARNINGS_CALENDAR_REFRESH_INTERVAL_HOURS=24
EARNINGS_CALENDAR_LOOKBACK_DAYS=30
EARNINGS_CALENDAR_LOOKAHEAD_DAYS=90
EARNINGS_RELEASE_INGESTION_LOOKBACK_DAYS=7

# Agent System
AGENT_MODE_ENABLED=true
AGENT_TECHNICALS_LOOKBACK_BARS=390

# FRED Macroeconomic Data (free API key: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=
FRED_REFRESH_INTERVAL_HOURS=24

# Fundamentals refresh cadence
FUNDAMENTALS_REFRESH_INTERVAL_DAYS=7
ANALYST_RATINGS_REFRESH_INTERVAL_DAYS=1

# Broker (Alpaca)
# 模拟盘: https://paper-api.alpaca.markets
# 实盘:   https://api.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Live Trading (Agent → Alpaca 自动下单)
# LIVE_TRADING_ENABLED=false  → 改为 true 启动自动交易
LIVE_TRADING_ENABLED=true
# 指定要交易的 ticker 列表，逗号分隔（不填则使用 AGENT_TICKERS_OVERRIDE）
LIVE_TRADING_TICKERS=AAPL,NVDA,MSFT,JPM,XOM
